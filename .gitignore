/target/
*.log
*.pck
*.pkx
*.pwt
*.dat
*.dds
*.spt
*.dll
# The DirectStorage package marks native/bin DLLs as redistributable; its
# LICENSE.txt and NOTICES.txt are retained alongside them in the SDK folder.
!sdk/DirectStorage/**/native/bin/**/*.dll
.DS_Store
Thumbs.db
.env
.env.*
# Local toolchains and validation scratch data
/.cache/
# Committed real-byte fixtures (tests/fixtures): a real client's own trailer,
# entry records and payload bytes, trimmed to the entries a test needs. These
# are exceptions to the `*.pck`/`*.ecwld` ignores above on purpose -- a test
# that invents its own package cannot prove anything about the shipped format,
# and the whole point of the tree fixtures is that they ARE the client's bytes.
!/tests/fixtures/**/*.pck
!/tests/fixtures/**/*.ecwld
!/tests/fixtures/**/*.dat
!/tests/fixtures/**/*.ecbsd

# Private client files staged by the Drive connector
/google_drive/

# Python validation helpers
__pycache__/
*.pyc
google_drive/

# Lossless runtime terrain backing store (rebuildable client data)
/cache/

# Vendored vendor runtimes: AMD FidelityFX SDK 2.4.0 DX12 (MIT-style), Intel
# XeSS SDK 3.0.2 and NVIDIA DLSS/NGX (unmodified runtime DLLs from
# https://github.com/NVIDIA/DLSS under the NVIDIA RTX SDKs License). Each
# vendor's license text is vendored beside its binaries and
# THIRD_PARTY_NOTICES.md records the SHA-256 of every file. Everything else
# under sdk/ stays ignored — Streamline's sl.*.dll included.
/sdk/*
!/sdk/amd_fidelityfx_loader_dx12.dll
!/sdk/amd_fidelityfx_upscaler_dx12.dll
!/sdk/amd_fidelityfx_framegeneration_dx12.dll
# The FFX denoiser (FSR Ray Regeneration) Raywatcher's reconstruction option
# loads; same SDK release and license as the three above.
!/sdk/amd_fidelityfx_denoiser_dx12.dll
!/sdk/AMD_FidelityFX-SDK-2.4.0-notices.md
!/sdk/AMD_FidelityFX-SDK-2.4.0-LICENSE.md
# The FidelityFX SDK API headers used by the FFI integration (MIT-style,
# same license terms as the binaries above; kept for reference and review).
!/sdk/include/
!/sdk/include/**
# The Intel XeSS / XeSS-FG / XeLL runtime DLLs (XeSS SDK 3.0.2). The Intel
# Simplified Software License allows redistribution of the unmodified binaries
# provided the copyright notice and terms travel with them, which is why
# sdk/Intel_XeSS-SDK-3.0.2-LICENSE.txt and the third-party notice are vendored
# next to them and THIRD_PARTY_NOTICES.md records the SHA-256 of each file.
# Without these three files the Graphics tab keeps XeSS, XeSS Frame Generation
# and the XeLL Latency mode disabled with a "not found" reason.
!/sdk/libxess.dll
!/sdk/libxess_fg.dll
!/sdk/libxell.dll
!/sdk/nvngx_dlss.dll
!/sdk/nvngx_dlssg.dll
# Ray reconstruction (DLSS RR), same DLSS release and license.
!/sdk/nvngx_dlssd.dll
!/sdk/NVIDIA_DLSS-SDK-LICENSE.txt
# The NGX headers the DLSS FFI was written against (same repository and
# license); kept for review and for tools/verify-vendor-sdks.py.
!/sdk/include/nvidia/
!/sdk/include/nvidia/**
!/sdk/Intel_XeSS-SDK-3.0.2-LICENSE.txt
!/sdk/Intel_XeSS-SDK-3.0.2-third-party-programs.txt
# The Intel XeSS headers the FFI integration was written against (XeSS SDK
# 3.0.2, same license); kept for review and for tools/verify-vendor-sdks.py,
# which checks every constant and export against them.
!/sdk/include/xess/
!/sdk/include/xess/**
!/sdk/include/xess_fg/
!/sdk/include/xess_fg/**
!/sdk/include/xell/
!/sdk/include/xell/**
/tools/.toolchain/

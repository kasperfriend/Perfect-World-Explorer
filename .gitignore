*.dll
.DS_Store
Thumbs.db
.env
.env.*
# Local toolchains and validation scratch data
/.cache/
# Private client files staged by the Drive connector
/google_drive/

# Python validation helpers
__pycache__/
*.pyc
google_drive/

# Lossless runtime terrain backing store (rebuildable client data)
/cache/

# Vendored AMD FSR SDK 2.4.0 DX12 runtime (MIT, redistributable with notice;
# see THIRD_PARTY_NOTICES.md). Everything else under sdk/ stays ignored —
# NVIDIA proprietary DLLs are never committed, and any other vendor files stay out.
/sdk/*
!/sdk/amd_fidelityfx_loader_dx12.dll
!/sdk/amd_fidelityfx_upscaler_dx12.dll
!/sdk/amd_fidelityfx_framegeneration_dx12.dll
!/sdk/AMD_FidelityFX-SDK-2.4.0-notices.md
!/sdk/AMD_FidelityFX-SDK-2.4.0-LICENSE.md
# The FidelityFX SDK API headers used by the FFI integration (MIT-style,
# same license terms as the binaries above; kept for reference and review).
!/sdk/include/
!/sdk/include/**
# The Intel XeSS / XeSS-FG / XeLL runtime DLLs (XeSS SDK 3.0.2). The Intel
# Simplified Software License allows redistribution of the unmodified binaries
# provided the copyright notice and terms travel with them, which is why
# sdk/Intel_XeSS-SDK-3.0.2-LICENSE.txt and the third-party notice are vendored
# next to them and THIRD_PARTY_NOTICES.md records the SHA-256 of each file.
# Without these three files the Graphics tab keeps XeSS, XeSS Frame Generation
# and the XeLL Latency mode disabled with a "not found" reason.
!/sdk/libxess.dll
!/sdk/libxess_fg.dll
!/sdk/libxell.dll
!/sdk/Intel_XeSS-SDK-3.0.2-LICENSE.txt
!/sdk/Intel_XeSS-SDK-3.0.2-third-party-programs.txt
# The Intel XeSS headers the FFI integration was written against (XeSS SDK
# 3.0.2, same license); kept for review and for tools/verify-vendor-sdks.py,
# which checks every constant and export against them.
!/sdk/include/xess/
!/sdk/include/xess/**
!/sdk/include/xess_fg/
!/sdk/include/xess_fg/**
!/sdk/include/xell/
!/sdk/include/xell/**
